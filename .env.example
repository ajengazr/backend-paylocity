# Salin berkas ini menjadi .env, lalu isi nilainya. Jangan pernah commit .env.

# ---- Basis data ----
# Connection string Supabase. DIRECT_URL dipakai Prisma saat menjalankan migrasi.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---- Server ----
SERVER_PORT=3000

# Asal frontend yang boleh memanggil API. Boleh lebih dari satu, dipisah koma.
CORS_ORIGIN="http://localhost:5173"

# ---- Token ----
# Wajib diisi, minimal 32 byte. Server menolak start bila kosong atau terlalu pendek.
# Buat nilainya dengan: openssl rand -base64 48
JWT_TOKEN=""
JWT_EXP="1d"

# ---- Cookie sesi ----
# Biarkan true di produksi (HTTPS). Isi "false" hanya untuk pengembangan lokal
# lewat HTTP, karena browser menolak cookie Secure di koneksi tanpa TLS.
COOKIE_SECURE=true

# ---- Bootstrap SUPER_ADMIN ----
# Hanya untuk sekali pakai pada basis data kosong. Setelah akunnya terbentuk,
# kembalikan ke false dan hapus passwordnya dari environment.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME="MANAJER"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
